  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OIDC JWT with issuer, audience, expiry, sub, tenant and CUSTOMER or MANAGER realm role. Tenant and owner come from the token."
      }
    },
    "schemas": {
      "OrderStatus": {
        "type": "string",
        "enum": [
          "PLACED",
          "REFUNDED"
        ]
      },
      "CreateOrder": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": ".*\\S.*"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "additionalProperties": true,
        "description": "Unknown request fields are ignored for compatibility. Quantity and version require JSON integer tokens: numeric strings and floating-point tokens (including 2.0) are rejected by HTTP decoding. JSON Schema integer describes mathematical integral values; the wire-token restriction is an additional transport constraint."
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalCents": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "sku",
          "quantity",
          "totalCents",
          "status",
          "version"
        ],
        "additionalProperties": false
      },
      "OrderPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
