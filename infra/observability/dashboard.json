{
  "uid": "architecture-reference",
  "title": "Architecture Reference",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Outbox pending",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "commerce_outbox_pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Audit effects",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(commerce_audit_processed_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Audit duplicates",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "commerce_audit_duplicates_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Streams max lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "analytics_records_lag_max",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Late / invalid events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "analytics_late_events_total + analytics_invalid_events_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "AI outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by(outcome, mode)(rate(ai_requests_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "AI latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(ai_answer_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "HTTP server errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
